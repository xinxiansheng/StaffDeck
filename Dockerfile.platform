# Source-only platform build. af1/af2 behavior is maintained in this repository;
# do not overlay facade.py/runs.py or apply external patches to this image.
FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 git ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY . .
RUN corepack enable && pnpm_config_fetch_timeout=600000 pnpm_config_fetch_retries=5 \
    pnpm_config_network_concurrency=4 python3 prepare.py --without-backend
RUN python3 packaging/fetch_sandbox_runtime.py packaging/sandbox_runtime

FROM python:3.11-slim-bookworm AS app
# Linux SRT requires all three tools in the final image, not just the build stage.
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 bubblewrap ripgrep socat && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/node /usr/local/bin/node
WORKDIR /app
COPY --from=build /app /app
RUN pip install --no-cache-dir ./backend && python packaging/distribution/install_dependencies.py
RUN useradd --uid 10001 --create-home staffdeck && mkdir /data && chown staffdeck:staffdeck /data
USER staffdeck
RUN rg --version && socat -V && bwrap --version
ENV STAFFDECK_SRT_RUNTIME=/app/packaging/sandbox_runtime STAFFDECK_DISTRIBUTION_MANIFEST=/app/distribution/manifest.json STAFFDECK_INSTALL_ROOT=/app
ENV ULTRARAG_DATA_DIR=/data ULTRARAG_HOST=0.0.0.0 ULTRARAG_PORT=5173 STAFFDECK_HEADLESS=true
VOLUME ["/data"]
EXPOSE 5173
CMD ["python", "launch.py"]
